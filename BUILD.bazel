load("@rules_cc//cc:defs.bzl", "cc_library")

config_setting(
    name = "dbg",
    values = {"compilation_mode": "dbg"},
)

cc_library(
    name = "bx",
    srcs = glob(
        ["src/*.cpp"],
        exclude = [
            "src/amalgamated.cpp",
            "src/crtnone.cpp",
        ],
    ) + select({
        "@platforms//os:linux": glob(["include/compat/linux/*.h"]),
        "//conditions:default": [],
    }),
    hdrs = glob([
        "include/bx/*.h",
        "include/bx/inline/*.inl",
    ]),
    copts = [
        "-march=native",
        "-ffast-math",
    ],
    cxxopts = [
        "-std=c++20",
        "-fno-exceptions",
        "-fno-rtti",
    ],
    defines = [
        "__STDC_LIMIT_MACROS",
        "__STDC_FORMAT_MACROS",
        "__STDC_CONSTANT_MACROS",
    ] + select({
        ":dbg": ["BX_CONFIG_DEBUG=1"],
        "//conditions:default": ["BX_CONFIG_DEBUG=0"],
    }),
    linkopts = [
        "-lpthread",
        "-ldl",
        "-lrt",
    ],
    strip_include_prefix = "include",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = ["//3rdparty/ini"],
)
