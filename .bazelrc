common --enable_bzlmod

# Pin clang as the C/C++ compiler. This is a personal fork; gcc is unsupported.
build --action_env=CC=clang
build --action_env=CXX=clang++
build --repo_env=CC=clang
build --repo_env=CXX=clang++

# C++20 everywhere (matches GENie Cpp20 flag in scripts/toolchain.lua).
# Moved to bazel/copts.bzl for cc_library target specifically.
# build --cxxopt=-std=c++20
# build --host_cxxopt=-std=c++20

# Keep action env reproducible.
build --incompatible_strict_action_env
